# paylasim/gizli/.env olarak kopyala ve doldur:
#     mkdir -p paylasim/gizli && cp paylasim/ornek.env paylasim/gizli/.env
#
# gizli/ .gitignore'da — buraya yazdıkların repoya girmez.
# Cron kabuk profilini okumadığı için anahtarlar burada durmalı,
# ~/.zshrc'de değil.

# --- Instagram ---
# instagram = graph.instagram.com, Facebook Sayfası GEREKMİYOR (Creator+Business)
# facebook  = graph.facebook.com, Sayfa gerekiyor (yalnız Business)
IG_YOL=instagram

# developers.facebook.com → uygulaman → Instagram → API setup with Instagram
# business login → Instagram app ID ve Instagram app secret
IG_UYGULAMA_ID=
IG_UYGULAMA_SIRRI=

# `kur.py --platform instagram --kod ...` bunu sana yazdırıyor
IG_KULLANICI_ID=

# --- TikTok ---
# developers.tiktok.com → uygulaman → Basic information
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# inbox = taslağa düşer, telefonda Post'a basarsın (denetimden önce bu)
# direct = doğrudan yayına girer (yalnız denetim geçtikten SONRA)
TIKTOK_YOL=inbox

# --- Medya ---
# Vercel Blob taban adresi; gün klasörleri bunun altında
MEDYA_TABAN_URL=https://6khfg6gwjc8v5js8.public.blob.vercel-storage.com
