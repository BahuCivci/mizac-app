# paylasim/gizli/.env olarak kopyala ve doldur:
#     mkdir -p paylasim/gizli && cp paylasim/ornek.env paylasim/gizli/.env
#
# gizli/ .gitignore'da — buraya yazdıkların repoya girmez.
# Cron kabuk profilini okumadığı için anahtarlar burada durmalı,
# ~/.zshrc'de değil.

# --- Instagram ---
# instagram = graph.instagram.com, Facebook Sayfası GEREKMİYOR (Creator+Business)
# facebook  = graph.facebook.com, Sayfa gerekiyor (yalnız Business)
IG_YOL=instagram

# developers.facebook.com → uygulaman → Instagram → API setup with Instagram
# business login → Instagram app ID ve Instagram app secret
IG_UYGULAMA_ID=
IG_UYGULAMA_SIRRI=

# `kur.py --platform instagram --kod ...` bunu sana yazdırıyor
IG_KULLANICI_ID=

# --- TikTok ---
# developers.tiktok.com → uygulaman → Basic information
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# inbox = taslağa düşer, telefonda Post'a basarsın (denetimden önce bu)
# direct = doğrudan yayına girer (yalnız denetim geçtikten SONRA)
TIKTOK_YOL=inbox

# --- YouTube ---
# console.cloud.google.com → projen → API'ler ve Hizmetler → Kimlik bilgileri
# → OAuth istemci kimliği oluştur → tür: "Web uygulaması"
# Yetkili yönlendirme URI'sine OAUTH_YONLENDIRME ile BİREBİR aynısını yaz.
# "YouTube Data API v3" ayrıca etkinleştirilmeli.
YOUTUBE_ISTEMCI_ID=
YOUTUBE_ISTEMCI_SIRRI=

# private / unlisted / public
#
# VARSAYILAN private, BİLEREK. API projesi denetimden (audit) geçmediyse
# YouTube yüklenen videoyu zaten gizli KİLİTLİYOR ve bu geri alınamıyor —
# itiraz hakkı yok, videoyu silip elle yeniden yüklemek gerekiyor.
# TikTok'un `inbox`'ı gibi bir kaçış yolu YouTube'da yok.
#
# public yapmadan önce denetim: support.google.com/youtube/contact/yt_api_form
YOUTUBE_GIZLILIK=private

# Video kategorisi. 27 = Education, 22 = People & Blogs, 24 = Entertainment
YOUTUBE_KATEGORI=27

# --- Medya ---
# Vercel Blob taban adresi; gün klasörleri bunun altında
MEDYA_TABAN_URL=https://6khfg6gwjc8v5js8.public.blob.vercel-storage.com

# --- OAuth ---
# Onay sonrası tarayıcının döneceği adres. HTTPS olmak ZORUNDA (Meta, TikTok
# ve Google http:// kabul etmiyor, localhost dahil). Platformun uygulama
# ayarlarına da BİREBİR aynı yazılmalı. Varsayılan: https://mizac.xyz/
OAUTH_YONLENDIRME=https://mizac.xyz/
