{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit --skipLibCheck)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(vercel --prod --yes)",
      "Bash(vercel --version)",
      "Bash(ls /Users/bahu/Documents/mizac-app/app/**)",
      "Bash(mkdir -p:*)",
      "Bash(chmod +x:*)"
    ],
    "additionalDirectories": [
      "/Users/bahu/Documents/mizac-app/app",
      "/Users/bahu/Documents/mizac-app/lib",
      "/Users/bahu/Documents/mizac-app/components",
      "/Users/bahu/Documents/mizac-app/tests",
      "/Users/bahu/Documents/mizac-app/kaynak"
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser", "chromium"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ts-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
